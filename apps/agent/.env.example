# ---------------------------------------------------------------------------
# Weighbridge agent (on-site Windows PC) — copy to .env and fill in.
# The powerful Mongo credential never lives here: the agent only ever talks to
# the cloud API with an ingest key (brief §12).
# ---------------------------------------------------------------------------

# Localhost HTTP API + Operator PWA. Bound to 127.0.0.1 only.
PORT=3100
STATION_ID=A

# Local source of truth. Relative paths resolve against the agent's data dir.
DATABASE_PATH=./data/weighbridge.sqlite

# --- Indicator (serial) ----------------------------------------------------
# Windows: COM3, COM4... Linux/macOS dev: /dev/ttyUSB0
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=9600
SERIAL_DATA_BITS=8
SERIAL_STOP_BITS=1
SERIAL_PARITY=none

# Set true to run the built-in weight simulator instead of a real port, so all
# development works with no hardware attached (brief §13-M1).
USE_SIMULATOR=true

# --- Cloud sync ------------------------------------------------------------
# Nothing here: the cloud address and key live in src/deployment.ts, so they
# can be changed by pushing code rather than by visiting the weighbridge.
SYNC_INTERVAL_SECONDS=300

# Scheduled SQLite copy (brief §12). Blank disables it.
BACKUP_PATH=
BACKUP_INTERVAL_HOURS=24

# --- Cameras ----------------------------------------------------------------
# Full snapshot URL per camera. Hikvision stills are at
#   http://<ip>/ISAPI/Streaming/channels/102/picture   (102 = sub-stream)
# Leave blank to disable a camera; the slip then prints the placeholder.
CAMERA_FRONT_URL=
CAMERA_SIDE_URL=
CAMERA_USERNAME=
CAMERA_PASSWORD=
CAMERA_TIMEOUT_MS=2500
CAMERA_LIVE_FPS=3
CAPTURE_PATH=./data/captures
CAPTURE_KEEP_DAYS=60
