{
  "name": "@suarza/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "SERVE_OPERATOR_WEB=false tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "service:install": "node windows/install-service.cjs",
    "service:uninstall": "node windows/uninstall-service.cjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.1",
    "@suarza/shared": "workspace:*",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "serialport": "^12.0.0",
    "zod": "^3.23.8",
    "@suarza/receipt-pdf": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "optionalDependencies": {
    "node-windows": "^1.0.0-beta.8"
  }
}
