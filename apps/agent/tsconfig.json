{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // NodeNext rather than the workspace default Bundler: this is a real Node
    // process, not something a bundler resolves, and it consumes CJS natives
    // (better-sqlite3) alongside ESM.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "test"]
}
