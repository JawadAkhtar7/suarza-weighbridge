{
  "name": "@suarza/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "SERVE_MANAGER_WEB=false tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "resolve-conflict": "tsx src/maintenance/resolve-slip-conflict.ts",
    "backfill-ledger": "tsx src/maintenance/backfill-ledger.ts",
    "migrate-ledger-ids": "tsx src/maintenance/migrate-ledger-ids.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@suarza/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "zod": "^3.23.8",
    "@suarza/receipt-pdf": "workspace:*",
    "pdfkit": "^0.15.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode": "^1.5.5"
  }
}
