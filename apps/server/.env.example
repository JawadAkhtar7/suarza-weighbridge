# ---------------------------------------------------------------------------
# Cloud API (DigitalOcean droplet) — copy to .env and fill in real values.
# .env is git-ignored and must NEVER be committed (brief §5, §12).
# ---------------------------------------------------------------------------

# MongoDB Atlas. The URI MUST end with the database name `suarzaweightbridge` —
# without it Mongoose silently connects to the cluster default, not our data.
# There is exactly one Mongo variable; do not add a second DB_NAME alongside it.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.wrxrpup.mongodb.net/suarzaweightbridge

# Public origin of this server, used to build the receipt QR URLs (/r/:slip).
APP_DOMAIN=https://weighbridge.example.com

PORT=4000
NODE_ENV=development

# Signs manager JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=<replace-with-a-long-random-string>
JWT_EXPIRES_IN=12h

# Shared secret the on-site agent presents on POST /ingest. Must match the
# agent's CLOUD_API_KEY exactly. Generate with: openssl rand -hex 32
INGEST_API_KEY=<replace-with-a-long-random-string>

# The company's name, address, phone and website are NOT configured here, and
# not in the operator's Settings either. They are the same on every deployment
# and on every slip, so they live in code:
#   packages/shared/src/constants/company.ts
# Change them there, push, and the operator presses Update.
